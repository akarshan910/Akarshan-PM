# Names only. Never put a value in this file or commit a filled copy (01 · Environment).
# Local development reads .env.local, which .gitignore covers.

# Browser (public by design; RLS protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Build
SITE_URL=

# Owner's shell only, for one command at a time. Never in Vercel, CI or a file.
# OWNER_EMAIL=            npm run setup:owner
# SUPABASE_URL=           setup:owner, seed:v0, backup
# SUPABASE_SERVICE_ROLE_KEY=  setup:owner, seed:v0, backup
# PM_DATABASE_URL=        npm run db:migrate

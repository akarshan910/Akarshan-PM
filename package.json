{
  "name": "akarshan-pm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "node scripts/check-env.ts && react-router build && node scripts/check-build.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run -c supabase/vitest.config.ts",
    "e2e": "playwright test",
    "db:migrate": "node scripts/migrate.ts",
    "setup:owner": "node scripts/not-yet.ts setup:owner",
    "seed:v0": "node scripts/not-yet.ts seed:v0",
    "backup": "node scripts/not-yet.ts backup",
    "preview": "vite preview --outDir build/client",
    "db:lint": "node scripts/migration-lint.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@supabase/supabase-js": "2.117.3",
    "isbot": "5.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.56.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}

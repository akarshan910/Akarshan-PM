                    "3 mo",
                    "7.3",
                  ],
                  [
                    "4",
                    "Video Feed",
                    "9",
                    "2.5",
                    "95%",
                    "3 mo",
                    "7.1",
                  ],
                  [
                    "5",
                    "Personalised Spiritual Calendar & Reminders",
                    "9",
                    "2",
                    "95%",
                    "2.5 mo",
                    "6.8",
                  ],
                  [
                    "6",
                    "Subscription Packages",
                    "8",

                    "85%",
                    "1.5 mo",
                    "5.7",
                  ],
                  [
                    "7",
                    "Complementary Puja Suggestions",
                    "6",
                    "2",
                    "65%",
                    "2 mo",
                    "3.9",
                  ],
                  [
                    "8",
                    "Tiered Loyalty Rewards",
                    "6",
                    "2",
                    "65%",
                    "3 mo",
                    "2.6",
                  ],
                  [
                    "9",
                    "Puja & Aashirvaad Box Authenticity",
                    "5",
